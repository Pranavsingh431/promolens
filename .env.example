# Copy this file to .env.local and fill in real values. Never commit real keys.
# Keys are read only by server code.

# OpenRouter API key. Not needed for the app shell or the tests.
# Needed by `npm run discover` and `npm run rank`. Check the account settings
# listed in docs/discovery.md before sending any screenplay.
OPENROUTER_API_KEY=

# Optional. Another OpenAI-compatible API to use instead of OpenRouter.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional. Discovery model. The privacy routing check runs for any model.
# PROMOLENS_DISCOVERY_MODEL=anthropic/claude-haiku-5.5

# Optional. Ranking models (docs/ranking.md). The privacy routing check runs for any model.
# PROMOLENS_SCREEN_MODEL=anthropic/claude-haiku-5.5
# PROMOLENS_EVALUATOR_MODEL=openai/gpt-6-luna

# ----- Persistent analysis backend (see docs/backend.md) -----
# Leave these unset and the site shows the demo and refuses all analysis.
# Nothing here is provisioned automatically.

# PostgreSQL. Use a pooled connection string on Vercel. For local work with
# nothing to install: pglite:.data/db (never allowed on Vercel).
DATABASE_URL=
# Optional direct (unpooled) connection, used only by npm run db:migrate and
# drizzle-kit when set. Hosted PostgreSQL on Vercel usually provides one.
# DATABASE_URL_UNPOOLED=

# Editors who may sign in, comma separated, as name:hash.
# Make an entry with: npm run access:hash -- your-name
PROMOLENS_EDITORS=

# Where uploads and results are kept: vercel-blob or local.
# A vercel-blob store must be created as PRIVATE. Check it with: npm run cloud:verify
PROMOLENS_STORAGE=
# With vercel-blob, on Vercel: BLOB_STORE_ID (OIDC). Elsewhere: BLOB_READ_WRITE_TOKEN.
# BLOB_WEBHOOK_PUBLIC_KEY is also required: the Blob SDK refuses every presigned
# upload without it. Connecting the store to the project should provide it.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
# BLOB_WEBHOOK_PUBLIC_KEY=
# With local (never allowed on Vercel):
# PROMOLENS_LOCAL_STORAGE_DIR=.data/objects

# Optional limits. These are the defaults.
# PROMOLENS_JOB_BUDGET_USD=1.5
# PROMOLENS_ROLLING_BUDGET_USD=15
# PROMOLENS_JOB_MAX_REQUESTS=6000
# PROMOLENS_MODEL_CONCURRENCY=8
# PROMOLENS_MODEL_TIMEOUT_SECONDS=120
# PROMOLENS_MODEL_ATTEMPTS=3
# PROMOLENS_STEP_BUDGET_SECONDS=200
# PROMOLENS_RETENTION_DAYS=30
